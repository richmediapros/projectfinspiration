---
import Base from '../../layouts/Base.astro';
import { requireAdmin } from '../../lib/auth';
import { env } from 'cloudflare:workers';

const forbidden = requireAdmin(Astro);
if (forbidden) return forbidden;

const db = env.DB;
let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'add') {
    const name = String(form.get('name') ?? '').trim();
    if (!name) {
      error = 'Category name is required.';
    } else {
      const existing = await db.prepare('SELECT id FROM categories WHERE name = ?').bind(name).first();
      if (existing) {
        error = `"${name}" already exists.`;
      } else {
        const id = crypto.randomUUID();
        await db.prepare('INSERT INTO categories (id, name) VALUES (?, ?)').bind(id, name).run();
        success = `"${name}" added.`;
      }
    }
  } else if (action === 'delete') {
    const categoryId = String(form.get('category_id') ?? '');
    const vendorCount = await db
      .prepare('SELECT COUNT(*) as count FROM vendor_categories WHERE category_id = ?')
      .bind(categoryId)
      .first<{ count: number }>();

    if (vendorCount && vendorCount.count > 0) {
      error = `Cannot delete: ${vendorCount.count} vendor(s) use this category. Remove them first.`;
    } else {
      await db.prepare('DELETE FROM categories WHERE id = ?').bind(categoryId).run();
      success = 'Category deleted.';
    }
  } else if (action === 'rename') {
    const categoryId = String(form.get('category_id') ?? '');
    const name = String(form.get('name') ?? '').trim();
    if (!name) {
      error = 'Category name is required.';
    } else {
      await db.prepare('UPDATE categories SET name = ? WHERE id = ?').bind(name, categoryId).run();
      success = `Category renamed to "${name}".`;
    }
  }
}

interface Category {
  id: string;
  name: string;
  vendor_count: number;
}

const categories = (await db
  .prepare(`
    SELECT c.id, c.name, COUNT(vc.vendor_id) as vendor_count
    FROM categories c
    LEFT JOIN vendor_categories vc ON vc.category_id = c.id
    GROUP BY c.id
    ORDER BY c.name
  `)
  .all<Category>()).results;
---

<Base title="Categories | Admin | TrustConstellation">
  <div class="page-header">
    <div class="overline">Admin</div>
    <h1>Categories</h1>
    <p class="description">Manage vendor categories used to organize and filter vendors.</p>
  </div>

  {error && <div class="alert alert-error">{error}</div>}
  {success && <div class="alert alert-success">{success}</div>}

  <form method="POST" class="add-row">
    <input type="hidden" name="action" value="add" />
    <div class="form-group" style="flex:1; margin-bottom: 0">
      <input type="text" name="name" placeholder="New category name..." required />
    </div>
    <button type="submit" class="btn btn-primary">Add Category</button>
  </form>

  {categories.length === 0 ? (
    <p class="empty">No categories yet. Add one above.</p>
  ) : (
    <div class="cat-list">
      {categories.map((c) => (
        <div class="cat-row">
          <div class="cat-info">
            <span class="cat-name">{c.name}</span>
            <span class="cat-count">{c.vendor_count} vendor{c.vendor_count !== 1 ? 's' : ''}</span>
          </div>
          <div class="cat-actions">
            <form method="POST" class="rename-form">
              <input type="hidden" name="action" value="rename" />
              <input type="hidden" name="category_id" value={c.id} />
              <input type="text" name="name" value={c.name} class="rename-input" />
              <button type="submit" class="btn btn-ghost btn-sm">Rename</button>
            </form>
            <form method="POST">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="category_id" value={c.id} />
              <button type="submit" class="btn btn-ghost btn-sm btn-danger-text" onclick="return confirm('Delete this category?')">Delete</button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}

  <style>
    .add-row {
      display: flex;
      gap: 0.5rem;
      align-items: flex-end;
      margin-bottom: 1.5rem;
      max-width: 500px;
    }
    .cat-list {
      display: flex;
      flex-direction: column;
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      max-width: 640px;
    }
    .cat-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 1rem;
      background: var(--surface);
      gap: 1rem;
    }
    .cat-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .cat-name {
      font-weight: 500;
      font-size: 0.9rem;
    }
    .cat-count {
      font-size: 0.75rem;
      color: var(--muted);
    }
    .cat-actions {
      display: flex;
      gap: 0.25rem;
      align-items: center;
    }
    .rename-form {
      display: flex;
      gap: 0.25rem;
      align-items: center;
    }
    .rename-input {
      width: 160px;
      font-size: 0.8rem;
      padding: 0.3rem 0.5rem;
    }
    .btn-danger-text {
      color: var(--error-text);
    }
    .btn-danger-text:hover {
      background: var(--error-bg);
    }
  </style>
</Base>
