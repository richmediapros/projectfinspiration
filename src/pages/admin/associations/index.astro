---
import Base from '../../../layouts/Base.astro';
import { requireAdmin } from '../../../lib/auth';
import { env } from 'cloudflare:workers';

const forbidden = requireAdmin(Astro);
if (forbidden) return forbidden;

const db = env.DB;
let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const abbreviation = String(form.get('abbreviation') ?? '').trim();
  const state = String(form.get('state') ?? '').trim();
  const memberTerm = String(form.get('member_term') ?? '').trim() || 'Associate Member';

  if (!name) {
    error = 'Association name is required.';
  } else {
    const id = crypto.randomUUID();
    await db
      .prepare('INSERT INTO associations (id, name, abbreviation, state, member_term) VALUES (?, ?, ?, ?, ?)')
      .bind(id, name, abbreviation || null, state || null, memberTerm)
      .run();
    success = `${name} added.`;
  }
}

interface Association {
  id: string;
  name: string;
  abbreviation: string | null;
  state: string | null;
  member_term: string;
  user_count: number;
}

const associations = (await db
  .prepare(`
    SELECT a.*, COUNT(u.id) as user_count
    FROM associations a
    LEFT JOIN users u ON u.association_id = a.id
    GROUP BY a.id
    ORDER BY a.name
  `)
  .all<Association>()).results;
---

<Base title="Associations | Admin | TrustConstellation">
  <div class="page-header">
    <div class="overline">Admin</div>
    <h1>Associations</h1>
    <p class="description">Manage state banking associations and their membership terminology.</p>
  </div>

  {error && <div class="alert alert-error">{error}</div>}
  {success && <div class="alert alert-success">{success}</div>}

  <div class="add-form">
    <h3>Add Association</h3>
    <form method="POST">
      <div class="form-row">
        <div class="form-group">
          <label for="name">Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" placeholder="e.g. Texas Bankers Association" required />
        </div>
        <div class="form-group" style="max-width: 120px">
          <label for="abbreviation">Abbreviation</label>
          <input type="text" id="abbreviation" name="abbreviation" placeholder="e.g. TBA" />
        </div>
        <div class="form-group" style="max-width: 80px">
          <label for="state">State</label>
          <input type="text" id="state" name="state" placeholder="TX" maxlength="2" />
        </div>
      </div>
      <div class="form-group">
        <label for="member_term">Vendor membership term</label>
        <input type="text" id="member_term" name="member_term" placeholder="Associate Member" value="Associate Member" />
        <div class="form-hint">What your association calls its vendor members (e.g. Associate Member, Affiliate Partner).</div>
      </div>
      <button type="submit" class="btn btn-primary">Save</button>
    </form>
  </div>

  {associations.length === 0 ? (
    <p class="empty">No associations yet. Add one above.</p>
  ) : (
    <div class="assoc-list">
      {associations.map((a) => (
        <a href={`/admin/associations/${a.id}`} class="assoc-row">
          <div class="assoc-info">
            <div class="assoc-name">
              {a.name}
              {a.abbreviation && <span class="badge badge-neutral">{a.abbreviation}</span>}
            </div>
            <div class="assoc-meta">
              {a.state && <span>{a.state}</span>}
              <span>{a.user_count} user{a.user_count !== 1 ? 's' : ''}</span>
              <span>Members called "{a.member_term}"</span>
            </div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      ))}
    </div>
  )}

  <style>
    .add-form {
      margin-bottom: 2rem;
      max-width: 900px;
    }
    .add-form h3 {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }
    .add-form form {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
    }
    .form-row .form-group { min-width: 160px; }
    .form-hint {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 0.25rem;
    }
    .assoc-list {
      display: flex;
      flex-direction: column;
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      max-width: 900px;
    }
    .assoc-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      background: var(--surface);
      color: inherit;
      transition: background 0.1s ease;
    }
    .assoc-row:hover {
      background: var(--surface-raised);
      color: inherit;
    }
    .assoc-row svg {
      color: var(--muted);
      flex-shrink: 0;
    }
    .assoc-name {
      font-weight: 600;
      font-size: 0.925rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.15rem;
    }
    .assoc-meta {
      display: flex;
      gap: 0.75rem;
      font-size: 0.8rem;
      color: var(--muted);
    }
    .assoc-meta span {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
  </style>
</Base>
