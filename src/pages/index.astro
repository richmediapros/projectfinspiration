---
import Public from '../layouts/Public.astro';
---

<Public title="TrustConstellation — Vendor Intelligence for Banking Associations">
  <section class="hero">
    <div class="hero-glow"></div>
    <svg class="hero-mark" viewBox="0 0 140 130" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g class="hero-mark-lines">
        <line x1="69.09" y1="23.8" x2="67.84" y2="56.46" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".75"/>
        <line x1="28.09" y1="31.79" x2="62.89" y2="18.63" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".75"/>
        <line x1="103.69" y1="100.84" x2="118" y2="82.1" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".75"/>
        <line x1="27.13" y1="38.38" x2="61.44" y2="59.71" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".75"/>
        <line x1="63.19" y1="68.61" x2="27.4" y2="107.17" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".75"/>
        <line x1="71.07" y1="68.76" x2="96.4" y2="100.3" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".75"/>
        <line x1="73.65" y1="64.96" x2="115" y2="75.63" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".75"/>
      </g>
      <g class="hero-mark-nodes">
        <circle cx="21.66" cy="34.26" r="3.65"/>
        <circle cx="69.51" cy="16.94" r="3.65"/>
        <circle cx="121.23" cy="76.86" r="3.65"/>
        <circle cx="100.04" cy="105.57" r="3.65"/>
        <circle cx="21.66" cy="112.64" r="5.47"/>
      </g>
      <circle class="hero-mark-hub" cx="67.23" cy="63.19" r="3.65"/>
    </svg>
    <div class="hero-inner">
      <span class="hero-badge">Built for State Banking Associations</span>
      <h1>Vendor intelligence, built for your association</h1>
      <p class="hero-sub">
        One place to track, compare, and evaluate fintech vendors across your
        entire association. Real data. Real feedback. No more spreadsheets.
      </p>
      <div class="hero-actions">
        <a href="/login" class="btn btn-primary btn-lg">Sign in</a>
        <a href="#how" class="btn btn-ghost btn-lg">See how it works &darr;</a>
      </div>
    </div>
    <div class="hero-ticker">
      <div class="ticker-item ticker-item-lg">
        <span class="ticker-num">390+</span>
        <span class="ticker-label">Vendors tracked</span>
      </div>
    </div>
  </section>

  <section id="how" class="how-it-works">
    <div class="how-inner">
      <div class="how-header">
        <h2>How it works</h2>
        <p class="how-sub">Three steps from sign-up to shared intelligence.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Your association joins</h3>
            <p>An admin from your state banking association requests access. Once approved, your whole team can sign in.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Browse and rate vendors</h3>
            <p>Search 390+ vendors across 48 categories. Rate them, leave notes, and see what other associations think.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Make better decisions together</h3>
            <p>Track endorsements, compare notes across state lines, and choose vendors backed by collective experience.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-inner">
      <p class="cta-tagline">Collective Insights. Confident Decisions.</p>
      <h2>Ready to see what your peers think?</h2>
      <div class="cta-actions">
        <a href="/request-access" class="btn btn-primary btn-lg">Request access</a>
        <a href="/login" class="btn btn-secondary btn-lg">Sign in</a>
      </div>
    </div>
  </section>

  <style>
    /* ── Hero: full-viewport with glow ── */
    .hero {
      position: relative;
      overflow: hidden;
      background: var(--bg);
      padding: 6rem 1.5rem 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100dvh;
      justify-content: center;
      gap: 4rem;
    }

    .hero-glow {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 50% at 20% 30%, rgba(46, 92, 184, 0.2) 0%, transparent 70%),
        radial-gradient(ellipse 40% 60% at 80% 70%, rgba(74, 122, 212, 0.12) 0%, transparent 70%),
        radial-gradient(ellipse 80% 40% at 50% 100%, rgba(46, 92, 184, 0.08) 0%, transparent 60%);
      pointer-events: none;
    }

    .hero-mark {
      position: absolute;
      width: clamp(400px, 50vw, 700px);
      height: auto;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.07;
      pointer-events: none;
      will-change: transform;
      transition: transform 0.15s ease-out;
    }
    .hero-mark-lines { fill: none; stroke: var(--muted); }
    .hero-mark-nodes { fill: var(--muted); }
    .hero-mark-hub { fill: var(--accent); }
    :root[data-theme='light'] .hero-mark-lines { stroke: #7a8496; }
    :root[data-theme='light'] .hero-mark-nodes { fill: #7a8496; }
    :root[data-theme='light'] .hero-mark-hub { fill: #1e499c; }

    .hero-inner {
      position: relative;
      max-width: 52rem;
      text-align: center;
    }

    .hero-badge {
      display: inline-block;
      background: var(--accent-muted);
      color: var(--accent-hover);
      font-size: 0.8125rem;
      font-weight: 600;
      padding: 0.375rem 1rem;
      border-radius: 999px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 2rem;
      border: 1px solid var(--accent-border);
    }

    .hero h1 {
      font-size: clamp(2.25rem, 5.5vw, 4rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
      background: linear-gradient(180deg, var(--text) 40%, var(--muted) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-sub {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: var(--text-secondary);
      max-width: 38rem;
      margin: 0 auto 2.5rem;
      line-height: 1.7;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-lg {
      padding: 0.8125rem 2rem;
      font-size: 1rem;
      border-radius: var(--radius-lg);
    }

    /* ── Hero ticker ──────────────────── */
    .hero-ticker {
      position: relative;
      display: flex;
      gap: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }

    .ticker-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }

    .ticker-num {
      font-family: var(--font-heading);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.02em;
    }

    .ticker-item-lg .ticker-num {
      font-size: 2.5rem;
    }

    .ticker-label {
      font-size: 0.8125rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 500;
    }

    .ticker-item-lg .ticker-label {
      font-size: 0.9rem;
      letter-spacing: 0.08em;
    }

    /* ── How it works ────────────────── */
    .how-it-works {
      padding: 4rem 1.5rem;
    }
    .how-inner {
      max-width: 720px;
      margin: 0 auto;
    }
    .how-header {
      margin-bottom: 2.5rem;
    }
    .how-header h2 {
      font-size: 1.5rem;
      margin-bottom: 0.35rem;
    }
    .how-sub {
      color: var(--text-secondary);
      font-size: 0.95rem;
      margin: 0;
    }
    .steps {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
    .step {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }
    .step-number {
      width: 36px;
      height: 36px;
      border-radius: 999px;
      background: var(--accent-muted);
      border: 1px solid var(--accent-border);
      color: var(--accent);
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.9rem;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
    .step-content h3 {
      font-size: 1rem;
      margin-bottom: 0.25rem;
    }
    .step-content p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin: 0;
      line-height: 1.55;
    }

    /* ── Bottom CTA band ─────────────── */
    .cta-band {
      border-top: 1px solid var(--border);
      background: var(--surface);
      padding: 3.5rem 1.5rem;
    }
    .cta-inner {
      max-width: 600px;
      margin: 0 auto;
      text-align: center;
    }
    .cta-tagline {
      font-family: var(--font-heading);
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--muted);
      margin: 0 0 0.75rem;
    }
    .cta-inner h2 {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }
    .cta-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* ── Responsive ───────────────────── */
    @media (max-width: 640px) {
      .hero {
        padding: 4rem 1.25rem 2.5rem;
        min-height: auto;
      }
      .hero-mark {
        width: 300px;
      }
      .hero-ticker {
        gap: 2rem;
      }
      .ticker-num {
        font-size: 1.375rem;
      }
      .ticker-item-lg .ticker-num {
        font-size: 2rem;
      }
      .step {
        flex-direction: column;
        gap: 0.75rem;
      }
      .cta-band {
        padding: 2.5rem 1.25rem;
      }
    }
  </style>

  <script>
    const hero = document.querySelector('.hero');
    const mark = document.querySelector('.hero-mark');
    if (hero && mark) {
      hero.addEventListener('mousemove', (e) => {
        const rect = hero.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width - 0.5) * 30;
        const y = ((e.clientY - rect.top) / rect.height - 0.5) * 30;
        mark.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;
      });
      hero.addEventListener('mouseleave', () => {
        mark.style.transform = 'translate(-50%, -50%)';
      });
    }
  </script>
</Public>
