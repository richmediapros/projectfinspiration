---
import Public from '../layouts/Public.astro';
---

<Public title="TrustConstellation — Vendor Intelligence for Banking Associations">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-badge">For State Banking Associations</div>
        <h1>Vendor intelligence,<br />shared across<br />state lines.</h1>
        <p class="hero-sub">
          See which vendors your peers trust. Share ratings, notes, and
          endorsements across banking associations — so every decision
          is backed by collective experience.
        </p>
        <div class="hero-actions">
          <a href="/login" class="btn btn-primary btn-lg">Sign in</a>
          <a href="/request-access" class="btn btn-secondary btn-lg">Request access</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="constellation-hero">
          <!-- spokes from center hub -->
          <line x1="200" y1="175" x2="100" y2="65" stroke="currentColor" stroke-width="1.2" opacity="0.2"/>
          <line x1="200" y1="175" x2="175" y2="40" stroke="currentColor" stroke-width="1.2" opacity="0.2"/>
          <line x1="200" y1="175" x2="50" y2="190" stroke="currentColor" stroke-width="1.2" opacity="0.2"/>
          <line x1="200" y1="175" x2="100" y2="290" stroke="currentColor" stroke-width="1.2" opacity="0.2"/>
          <line x1="200" y1="175" x2="175" y2="330" stroke="currentColor" stroke-width="1.2" opacity="0.2"/>
          <line x1="200" y1="175" x2="290" y2="290" stroke="currentColor" stroke-width="1.2" opacity="0.2"/>
          <line x1="200" y1="175" x2="340" y2="110" stroke="currentColor" stroke-width="1.2" opacity="0.2"/>
          <!-- outer nodes (gray, varying sizes) -->
          <circle cx="100" cy="65" r="28" fill="currentColor" opacity="0.2"/>
          <circle cx="175" cy="40" r="15" fill="var(--accent)" opacity="0.5"/>
          <circle cx="50" cy="190" r="35" fill="currentColor" opacity="0.2"/>
          <circle cx="100" cy="290" r="22" fill="currentColor" opacity="0.25"/>
          <circle cx="175" cy="330" r="17" fill="currentColor" opacity="0.18"/>
          <circle cx="290" cy="290" r="25" fill="currentColor" opacity="0.2"/>
          <circle cx="340" cy="110" r="15" fill="var(--accent)" opacity="0.5"/>
          <!-- center hub -->
          <circle cx="200" cy="175" r="40" fill="var(--accent)"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="stats-strip">
    <div class="stats-inner">
      <div class="stat">
        <span class="stat-number">1</span>
        <span class="stat-label">Association</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">390+</span>
        <span class="stat-label">Vendors Tracked</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">48</span>
        <span class="stat-label">Categories</span>
      </div>
    </div>
  </section>

  <section class="how-it-works">
    <div class="how-inner">
      <div class="how-header">
        <h2>How it works</h2>
        <p class="how-sub">Three steps from sign-up to shared intelligence.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Your association joins</h3>
            <p>An admin from your state banking association requests access. Once approved, your whole team can sign in.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Browse and rate vendors</h3>
            <p>Search 390+ vendors across 48 categories. Rate them, leave notes, and see what other associations think.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Make better decisions together</h3>
            <p>Track endorsements, compare notes across state lines, and choose vendors backed by collective experience.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-inner">
      <p class="cta-tagline">Collective Insights. Confidence.</p>
      <h2>Ready to see what your peers think?</h2>
      <div class="cta-actions">
        <a href="/request-access" class="btn btn-primary btn-lg">Request access</a>
        <a href="/login" class="btn btn-secondary btn-lg">Sign in</a>
      </div>
    </div>
  </section>

  <style>
    /* ── Hero: asymmetric split ───────── */
    .hero {
      padding: 4rem 1.5rem 2rem;
    }
    .hero-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }
    .hero-content {
      max-width: 520px;
    }
    .hero-badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      background: var(--accent-muted);
      border: 1px solid var(--accent-border);
      border-radius: 999px;
      padding: 0.3rem 0.85rem;
      margin-bottom: 1.25rem;
    }
    .hero h1 {
      font-size: clamp(2rem, 4.5vw, 2.75rem);
      line-height: 1.12;
      margin: 0 0 1.25rem;
      letter-spacing: -0.03em;
    }
    .hero-sub {
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.65;
      margin: 0 0 2rem;
    }
    .hero-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .btn-lg {
      padding: 0.65rem 1.5rem;
      font-size: 0.95rem;
    }

    /* ── Hero visual ─────────────────── */
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .constellation-hero {
      width: 100%;
      max-width: 380px;
      height: auto;
      color: var(--text);
    }

    /* ── Stats strip ─────────────────── */
    .stats-strip {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: var(--surface);
      padding: 2rem 1.5rem;
    }
    .stats-inner {
      max-width: 700px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2.5rem;
    }
    .stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }
    .stat-number {
      font-family: var(--font-heading);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--accent);
      line-height: 1;
    }
    .stat .stat-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      font-weight: 600;
    }
    .stat-divider {
      width: 1px;
      height: 36px;
      background: var(--border);
    }

    /* ── How it works ────────────────── */
    .how-it-works {
      padding: 4rem 1.5rem;
    }
    .how-inner {
      max-width: 720px;
      margin: 0 auto;
    }
    .how-header {
      margin-bottom: 2.5rem;
    }
    .how-header h2 {
      font-size: 1.5rem;
      margin-bottom: 0.35rem;
    }
    .how-sub {
      color: var(--text-secondary);
      font-size: 0.95rem;
      margin: 0;
    }
    .steps {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
    .step {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }
    .step-number {
      width: 36px;
      height: 36px;
      border-radius: 999px;
      background: var(--accent-muted);
      border: 1px solid var(--accent-border);
      color: var(--accent);
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.9rem;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
    .step-content h3 {
      font-size: 1rem;
      margin-bottom: 0.25rem;
    }
    .step-content p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin: 0;
      line-height: 1.55;
    }

    /* ── Bottom CTA band ─────────────── */
    .cta-band {
      border-top: 1px solid var(--border);
      background: var(--surface);
      padding: 3.5rem 1.5rem;
    }
    .cta-inner {
      max-width: 600px;
      margin: 0 auto;
      text-align: center;
    }
    .cta-tagline {
      font-family: var(--font-heading);
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--muted);
      margin: 0 0 0.75rem;
    }
    .cta-inner h2 {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }
    .cta-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* ── Responsive ───────────────────── */
    @media (max-width: 768px) {
      .hero-inner {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .hero-visual {
        order: -1;
      }
      .constellation-hero {
        max-width: 260px;
      }
      .stats-inner {
        gap: 1.5rem;
      }
      .stat-number {
        font-size: 1.35rem;
      }
      .stat .stat-label {
        font-size: 0.65rem;
      }
    }
    @media (max-width: 480px) {
      .stats-inner {
        flex-direction: column;
        gap: 1rem;
      }
      .stat-divider {
        width: 40px;
        height: 1px;
      }
    }
  </style>
</Public>
