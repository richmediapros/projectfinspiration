---
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { logActivity } from '../../lib/activity';

const db = env.DB;
let error = '';

interface Category {
  id: string;
  name: string;
}

const categories = (await db
  .prepare('SELECT id, name FROM categories ORDER BY name')
  .all<Category>()).results;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const website = String(form.get('website') ?? '').trim();
  const logoUrl = String(form.get('logo_url') ?? '').trim();
  const description = String(form.get('description') ?? '').trim();
  const contactName = String(form.get('contact_name') ?? '').trim();
  const contactEmail = String(form.get('contact_email') ?? '').trim();
  const contactPhone = String(form.get('contact_phone') ?? '').trim();
  const selectedCategories = form.getAll('categories').map(String);

  if (!name) {
    error = 'Vendor name is required.';
  } else {
    const id = crypto.randomUUID();
    await db
      .prepare(`INSERT INTO vendors (id, name, logo_url, website, description, contact_name, contact_email, contact_phone, created_by)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`)
      .bind(id, name, logoUrl || null, website || null, description || null,
            contactName || null, contactEmail || null, contactPhone || null,
            Astro.locals.userId ?? null)
      .run();

    if (selectedCategories.length > 0) {
      const stmts = selectedCategories.map((catId) =>
        db.prepare('INSERT INTO vendor_categories (vendor_id, category_id) VALUES (?, ?)').bind(id, catId)
      );
      await db.batch(stmts);
    }

    await logActivity(db, Astro.request, 'vendor_created', Astro.locals.userEmail!, name);
    return new Response(null, { status: 302, headers: { Location: `/vendors/${id}` } });
  }
}
---

<Base title="Add Vendor | Finspiration">
  <div class="page-header">
    <div class="overline"><a href="/vendors">Vendors</a></div>
    <h1>Add Vendor</h1>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form method="POST" class="vendor-form">
    <div class="form-section">
      <h3>Basic Info</h3>
      <div class="form-group">
        <label for="name">Vendor name <span class="required">*</span></label>
        <input type="text" id="name" name="name" required autofocus />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="website">Website</label>
          <input type="url" id="website" name="website" placeholder="https://example.com" />
        </div>
        <div class="form-group">
          <label for="logo_url">Logo URL</label>
          <input type="url" id="logo_url" name="logo_url" placeholder="https://example.com/logo.png" />
        </div>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3" placeholder="What does this vendor do?"></textarea>
      </div>
    </div>

    <div class="form-section">
      <h3>Categories</h3>
      {categories.length === 0 ? (
        <p class="form-hint">No categories yet. <a href="/admin/categories">Add some first</a>.</p>
      ) : (
        <div class="checkbox-grid">
          {categories.map((c) => (
            <label class="checkbox-label">
              <input type="checkbox" name="categories" value={c.id} />
              {c.name}
            </label>
          ))}
        </div>
      )}
    </div>

    <div class="form-section">
      <h3>Contact</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="contact_name">Name</label>
          <input type="text" id="contact_name" name="contact_name" />
        </div>
        <div class="form-group">
          <label for="contact_email">Email</label>
          <input type="email" id="contact_email" name="contact_email" />
        </div>
        <div class="form-group" style="max-width: 180px">
          <label for="contact_phone">Phone</label>
          <input type="tel" id="contact_phone" name="contact_phone" />
        </div>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Vendor</button>
      <a href="/vendors" class="btn btn-secondary">Cancel</a>
    </div>
  </form>

  <style>
    .vendor-form {
      max-width: 680px;
    }
    .form-section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.5rem;
      margin-bottom: 1rem;
    }
    .form-section h3 {
      font-size: 0.85rem;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.75rem;
    }
    .form-row { display: flex; gap: 1rem; flex-wrap: wrap; }
    .form-row .form-group { flex: 1; min-width: 180px; }
    .form-actions { display: flex; gap: 0.5rem; }
    .overline a { color: var(--muted); transition: color 0.12s ease; }
    .overline a:hover { color: var(--accent); }
    .checkbox-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 0.35rem;
    }
    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.88rem;
      padding: 0.35rem 0.5rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background 0.1s ease;
    }
    .checkbox-label:hover { background: var(--surface-raised); }
    .checkbox-label input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--accent);
    }
  </style>
</Base>
