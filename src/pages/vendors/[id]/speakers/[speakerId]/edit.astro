---
import Base from '../../../../../layouts/Base.astro';
import { requireAdmin } from '../../../../../lib/auth';
import { env } from 'cloudflare:workers';

const forbidden = requireAdmin(Astro);
if (forbidden) return forbidden;

const db = env.DB;
const { id, speakerId } = Astro.params;
let error = '';

interface Vendor { id: string; name: string; }
const vendor = await db.prepare('SELECT id, name FROM vendors WHERE id = ?').bind(id).first<Vendor>();
if (!vendor) return new Response('Not found', { status: 404 });

interface Speaker {
  id: string;
  vendor_id: string;
  name: string;
  title: string | null;
  email: string | null;
  phone: string | null;
  photo_url: string | null;
  bio: string | null;
  website: string | null;
  linkedin: string | null;
  topics: string | null;
  active: number;
}

let speaker = await db.prepare('SELECT * FROM speakers WHERE id = ? AND vendor_id = ?').bind(speakerId, id).first<Speaker>();
if (!speaker) return new Response('Not found', { status: 404 });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'delete') {
    await db.batch([
      db.prepare('DELETE FROM speaker_ratings WHERE speaker_id = ?').bind(speakerId),
      db.prepare('DELETE FROM speaker_notes WHERE speaker_id = ?').bind(speakerId),
      db.prepare('DELETE FROM speakers WHERE id = ?').bind(speakerId),
    ]);
    return new Response(null, { status: 302, headers: { Location: `/vendors/${id}` } });
  }

  const name = String(form.get('name') ?? '').trim();
  const title = String(form.get('title') ?? '').trim();
  const email = String(form.get('email') ?? '').trim();
  const phone = String(form.get('phone') ?? '').trim();
  const photoUrl = String(form.get('photo_url') ?? '').trim();
  const bio = String(form.get('bio') ?? '').trim();
  const website = String(form.get('website') ?? '').trim();
  const linkedin = String(form.get('linkedin') ?? '').trim();
  const topics = String(form.get('topics') ?? '').trim();
  const active = form.get('active') === 'on' ? 1 : 0;

  if (!name) {
    error = 'Speaker name is required.';
  } else {
    await db
      .prepare(`UPDATE speakers SET name = ?, title = ?, email = ?, phone = ?, photo_url = ?,
                bio = ?, website = ?, linkedin = ?, topics = ?, active = ?, updated_at = datetime('now')
                WHERE id = ?`)
      .bind(name, title || null, email || null, phone || null, photoUrl || null,
            bio || null, website || null, linkedin || null, topics || null, active, speakerId)
      .run();

    return new Response(null, { status: 302, headers: { Location: `/vendors/${id}/speakers/${speakerId}` } });
  }
}
---

<Base title={`Edit ${speaker.name} | TrustConstellation`}>
  <div class="page-header">
    <div class="overline"><a href={`/vendors/${id}`}>{vendor.name}</a> &rsaquo; <a href={`/vendors/${id}/speakers/${speakerId}`}>{speaker.name}</a></div>
    <h1>Edit Speaker</h1>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form method="POST" class="speaker-form">
    <div class="form-section">
      <h3>Speaker Info</h3>
      <div class="form-row">
        <div class="form-group" style="flex: 2">
          <label for="name">Full name <span class="required">*</span></label>
          <input type="text" id="name" name="name" value={speaker.name} required />
        </div>
        <div class="form-group" style="flex: 2">
          <label for="title">Title / Role</label>
          <input type="text" id="title" name="title" value={speaker.title ?? ''} />
        </div>
      </div>
      <div class="form-group">
        <label for="bio">Bio</label>
        <textarea id="bio" name="bio" rows="3">{speaker.bio ?? ''}</textarea>
      </div>
      <div class="form-group">
        <label for="topics">Speaking Topics</label>
        <input type="text" id="topics" name="topics" value={speaker.topics ?? ''} />
        <span class="form-hint">Comma-separated list of topics this speaker covers</span>
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="active" checked={speaker.active === 1} />
          Active speaker
        </label>
        <span class="form-hint">Inactive speakers are hidden from the vendor page but not deleted</span>
      </div>
    </div>

    <div class="form-section">
      <h3>Contact & Links</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value={speaker.email ?? ''} />
        </div>
        <div class="form-group" style="max-width: 180px">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" value={speaker.phone ?? ''} />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="website">Website</label>
          <input type="url" id="website" name="website" value={speaker.website ?? ''} />
        </div>
        <div class="form-group">
          <label for="linkedin">LinkedIn</label>
          <input type="url" id="linkedin" name="linkedin" value={speaker.linkedin ?? ''} />
        </div>
      </div>
      <div class="form-group">
        <label for="photo_url">Photo URL</label>
        <input type="url" id="photo_url" name="photo_url" value={speaker.photo_url ?? ''} />
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href={`/vendors/${id}/speakers/${speakerId}`} class="btn btn-secondary">Cancel</a>
    </div>
  </form>

  <div class="danger-zone">
    <h3>Danger Zone</h3>
    <form method="POST" data-confirm="This speaker and all their ratings and notes will be permanently deleted. This cannot be undone." data-confirm-title="Delete this speaker?" data-confirm-action="Delete Speaker">
      <input type="hidden" name="action" value="delete" />
      <p>Permanently delete this speaker, including all ratings and notes.</p>
      <button type="submit" class="btn btn-danger">Delete Speaker</button>
    </form>
  </div>

  <style>
    .speaker-form { max-width: 680px; }
    .form-actions { margin-bottom: 2rem; }
    .danger-zone { max-width: 680px; }
  </style>
</Base>
