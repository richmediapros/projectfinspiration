---
import Base from '../../../layouts/Base.astro';
import { requireAdmin } from '../../../lib/auth';
import { env } from 'cloudflare:workers';

const forbidden = requireAdmin(Astro);
if (forbidden) return forbidden;

const db = env.DB;
const { id } = Astro.params;
let error = '';

interface Vendor {
  id: string;
  name: string;
  logo_url: string | null;
  website: string | null;
  description: string | null;
  contact_name: string | null;
  contact_email: string | null;
  contact_phone: string | null;
  address: string | null;
}

let vendor = await db.prepare('SELECT * FROM vendors WHERE id = ?').bind(id).first<Vendor>();
if (!vendor) return new Response('Not found', { status: 404 });

interface Category { id: string; name: string; }
const allCategories = (await db.prepare('SELECT id, name FROM categories ORDER BY name').all<Category>()).results;

const currentCatIds = new Set(
  (await db.prepare('SELECT category_id FROM vendor_categories WHERE vendor_id = ?').bind(id).all<{ category_id: string }>())
    .results.map((r) => r.category_id)
);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'delete') {
    const speakerIds = (await db.prepare('SELECT id FROM speakers WHERE vendor_id = ?').bind(id).all<{ id: string }>()).results;
    const speakerCleanup = speakerIds.flatMap((s) => [
      db.prepare('DELETE FROM speaker_ratings WHERE speaker_id = ?').bind(s.id),
      db.prepare('DELETE FROM speaker_notes WHERE speaker_id = ?').bind(s.id),
    ]);
    await db.batch([
      ...speakerCleanup,
      db.prepare('DELETE FROM speakers WHERE vendor_id = ?').bind(id),
      db.prepare('DELETE FROM vendor_categories WHERE vendor_id = ?').bind(id),
      db.prepare('DELETE FROM ratings WHERE vendor_id = ?').bind(id),
      db.prepare('DELETE FROM notes WHERE vendor_id = ?').bind(id),
      db.prepare('DELETE FROM vendor_associations WHERE vendor_id = ?').bind(id),
      db.prepare('DELETE FROM vendors WHERE id = ?').bind(id),
    ]);
    return new Response(null, { status: 302, headers: { Location: '/vendors' } });
  }

  const name = String(form.get('name') ?? '').trim();
  const website = String(form.get('website') ?? '').trim();
  const logoUrl = String(form.get('logo_url') ?? '').trim();
  const description = String(form.get('description') ?? '').trim();
  const contactName = String(form.get('contact_name') ?? '').trim();
  const contactEmail = String(form.get('contact_email') ?? '').trim();
  const contactPhone = String(form.get('contact_phone') ?? '').trim();
  const address = String(form.get('address') ?? '').trim();
  const selectedCategories = form.getAll('categories').map(String);

  if (!name) {
    error = 'Vendor name is required.';
  } else {
    await db
      .prepare(`UPDATE vendors SET name = ?, logo_url = ?, website = ?, description = ?,
                contact_name = ?, contact_email = ?, contact_phone = ?, address = ?, updated_at = datetime('now')
                WHERE id = ?`)
      .bind(name, logoUrl || null, website || null, description || null,
            contactName || null, contactEmail || null, contactPhone || null, address || null, id)
      .run();

    await db.prepare('DELETE FROM vendor_categories WHERE vendor_id = ?').bind(id).run();
    if (selectedCategories.length > 0) {
      const stmts = selectedCategories.map((catId) =>
        db.prepare('INSERT INTO vendor_categories (vendor_id, category_id) VALUES (?, ?)').bind(id, catId)
      );
      await db.batch(stmts);
    }

    return new Response(null, { status: 302, headers: { Location: `/vendors/${id}` } });
  }
}
---

<Base title={`Edit ${vendor.name} | TrustConstellation`}>
  <div class="page-header">
    <div class="overline"><a href={`/vendors/${id}`}>{vendor.name}</a></div>
    <h1>Edit Vendor</h1>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form method="POST" class="vendor-form">
    <div class="form-section">
      <h3>Basic Info</h3>
      <div class="form-group">
        <label for="name">Vendor name <span class="required">*</span></label>
        <input type="text" id="name" name="name" value={vendor.name} required />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="website">Website</label>
          <input type="url" id="website" name="website" value={vendor.website ?? ''} />
        </div>
        <div class="form-group">
          <label for="logo_url">Logo URL</label>
          <input type="url" id="logo_url" name="logo_url" value={vendor.logo_url ?? ''} />
        </div>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3">{vendor.description ?? ''}</textarea>
      </div>
    </div>

    <div class="form-section">
      <h3>Categories</h3>
      {allCategories.length === 0 ? (
        <p class="form-hint">No categories yet.</p>
      ) : (
        <div class="checkbox-grid">
          {allCategories.map((c) => (
            <label class="checkbox-label">
              <input type="checkbox" name="categories" value={c.id} checked={currentCatIds.has(c.id)} />
              {c.name}
            </label>
          ))}
        </div>
      )}
    </div>

    <div class="form-section">
      <h3>Contact</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="contact_name">Name</label>
          <input type="text" id="contact_name" name="contact_name" value={vendor.contact_name ?? ''} />
        </div>
        <div class="form-group">
          <label for="contact_email">Email</label>
          <input type="email" id="contact_email" name="contact_email" value={vendor.contact_email ?? ''} />
        </div>
        <div class="form-group" style="max-width: 180px">
          <label for="contact_phone">Phone</label>
          <input type="tel" id="contact_phone" name="contact_phone" value={vendor.contact_phone ?? ''} />
        </div>
      </div>
      <div class="form-group">
        <label for="address">Address</label>
        <input type="text" id="address" name="address" value={vendor.address ?? ''} />
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href={`/vendors/${id}`} class="btn btn-secondary">Cancel</a>
    </div>
  </form>

  <div class="danger-zone">
    <h3>Danger Zone</h3>
    <form method="POST" data-confirm="This vendor and all its speakers, ratings, notes, and association relationships will be permanently deleted. This cannot be undone." data-confirm-title="Delete this vendor?" data-confirm-action="Delete Vendor">
      <input type="hidden" name="action" value="delete" />
      <p>Permanently delete this vendor, including all speakers, ratings, notes, and association relationships.</p>
      <button type="submit" class="btn btn-danger">Delete Vendor</button>
    </form>
  </div>

  <style>
    .vendor-form { max-width: 680px; }
    .form-actions { margin-bottom: 2rem; }
    .danger-zone { max-width: 680px; }
  </style>
</Base>
