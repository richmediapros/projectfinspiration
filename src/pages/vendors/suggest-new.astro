---
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';

const db = env.DB;

interface Category { id: string; name: string; }
const categories = (await db.prepare('SELECT id, name FROM categories ORDER BY name').all<Category>()).results;

let error = '';
let success = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const reason = String(form.get('reason') ?? '').trim();

  if (!name) {
    error = 'Vendor name is required.';
  } else {
    const suggestedData = JSON.stringify({
      name,
      website: String(form.get('website') ?? '').trim() || null,
      logo_url: String(form.get('logo_url') ?? '').trim() || null,
      description: String(form.get('description') ?? '').trim() || null,
      contact_name: String(form.get('contact_name') ?? '').trim() || null,
      contact_email: String(form.get('contact_email') ?? '').trim() || null,
      contact_phone: String(form.get('contact_phone') ?? '').trim() || null,
      address: String(form.get('address') ?? '').trim() || null,
      categories: form.getAll('categories').map(String),
    });

    await db
      .prepare('INSERT INTO suggestions (id, type, user_id, suggested_data, reason) VALUES (?, ?, ?, ?, ?)')
      .bind(crypto.randomUUID(), 'new_vendor', Astro.locals.userId!, suggestedData, reason || null)
      .run();

    success = true;
  }
}
---

<Base title="Suggest Vendor | TrustConstellation">
  <div class="page-header">
    <div class="overline"><a href="/vendors">Vendors</a></div>
    <h1>Suggest Vendor</h1>
    <p class="page-subtitle">Your suggestion will be reviewed by an administrator before being added.</p>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  {success ? (
    <div class="alert alert-success">
      Your vendor suggestion has been submitted and will be reviewed by an administrator.
      <a href="/vendors">Back to Vendors</a>
    </div>
  ) : (
    <form method="POST" class="vendor-form">
      <div class="form-section">
        <h3>Why add this vendor?</h3>
        <div class="form-group">
          <label for="reason">Tell us why this vendor should be listed</label>
          <textarea id="reason" name="reason" rows="2" placeholder="e.g. We use this vendor for core processing and think others would benefit..."></textarea>
        </div>
      </div>

      <div class="form-section">
        <h3>Basic Info</h3>
        <div class="form-group">
          <label for="name">Vendor name <span class="required">*</span></label>
          <input type="text" id="name" name="name" required autofocus />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="website">Website</label>
            <input type="url" id="website" name="website" placeholder="https://example.com" />
          </div>
          <div class="form-group">
            <label for="logo_url">Logo URL</label>
            <input type="url" id="logo_url" name="logo_url" placeholder="https://example.com/logo.png" />
          </div>
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3" placeholder="What does this vendor do?"></textarea>
        </div>
      </div>

      <div class="form-section">
        <h3>Categories</h3>
        {categories.length === 0 ? (
          <p class="form-hint">No categories available.</p>
        ) : (
          <div class="checkbox-grid">
            {categories.map((c) => (
              <label class="checkbox-label">
                <input type="checkbox" name="categories" value={c.id} />
                {c.name}
              </label>
            ))}
          </div>
        )}
      </div>

      <div class="form-section">
        <h3>Contact</h3>
        <div class="form-row">
          <div class="form-group">
            <label for="contact_name">Name</label>
            <input type="text" id="contact_name" name="contact_name" />
          </div>
          <div class="form-group">
            <label for="contact_email">Email</label>
            <input type="email" id="contact_email" name="contact_email" />
          </div>
          <div class="form-group" style="max-width: 180px">
            <label for="contact_phone">Phone</label>
            <input type="tel" id="contact_phone" name="contact_phone" />
          </div>
        </div>
        <div class="form-group">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" />
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Submit Suggestion</button>
        <a href="/vendors" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  )}

  <style>
    .vendor-form { max-width: 680px; }
    .page-subtitle { font-size: 0.88rem; color: var(--text-secondary); margin: 0.25rem 0 0; }
    .alert-success a { color: var(--accent); margin-left: 0.5rem; }
  </style>
</Base>
