---
import Base from '../../layouts/Base.astro';
import { isAdmin } from '../../lib/auth';
import { env } from 'cloudflare:workers';

const userIsAdmin = isAdmin(Astro.locals);

const db = env.DB;
const { id } = Astro.params;

interface Vendor {
  id: string;
  name: string;
  logo_url: string | null;
  website: string | null;
  description: string | null;
  contact_name: string | null;
  contact_email: string | null;
  contact_phone: string | null;
  address: string | null;
  created_by: string | null;
  created_at: string;
  updated_at: string;
  creator_name: string | null;
}

const vendor = await db
  .prepare(`
    SELECT v.*, u.name as creator_name
    FROM vendors v
    LEFT JOIN users u ON u.id = v.created_by
    WHERE v.id = ?
  `)
  .bind(id)
  .first<Vendor>();

if (!vendor) return new Response('Not found', { status: 404 });

interface CategoryRow { id: string; name: string; }
const vendorCategories = (await db
  .prepare('SELECT c.id, c.name FROM categories c JOIN vendor_categories vc ON vc.category_id = c.id WHERE vc.vendor_id = ?')
  .bind(id)
  .all<CategoryRow>()).results;

interface RatingAgg { rating: string; count: number; }
const ratingRows = (await db
  .prepare('SELECT rating, COUNT(*) as count FROM ratings WHERE vendor_id = ? GROUP BY rating')
  .bind(id)
  .all<RatingAgg>()).results;

const ratings = { up: 0, down: 0 };
for (const r of ratingRows) {
  if (r.rating === 'up' || r.rating === 'down') ratings[r.rating] = r.count;
}
const totalVotes = ratings.up + ratings.down;
const score = totalVotes > 0 ? Math.round((ratings.up / totalVotes) * 100) : null;

interface UserRating { rating: string; }
const userRating = Astro.locals.userId
  ? await db.prepare('SELECT rating FROM ratings WHERE user_id = ? AND vendor_id = ?')
      .bind(Astro.locals.userId, id).first<UserRating>()
  : null;

interface NoteRow {
  id: string;
  user_id: string;
  content: string;
  created_at: string;
  user_name: string;
  association_name: string | null;
}

const notes = (await db
  .prepare(`
    SELECT n.id, n.user_id, n.content, n.created_at, u.name as user_name, a.name as association_name
    FROM notes n
    JOIN users u ON u.id = n.user_id
    LEFT JOIN associations a ON a.id = u.association_id
    WHERE n.vendor_id = ?
    ORDER BY n.created_at DESC
    LIMIT 50
  `)
  .bind(id)
  .all<NoteRow>()).results;

interface VendorAssoc {
  association_name: string;
  relationship_type: string;
  member_term: string;
}

const vendorAssociations = (await db
  .prepare(`
    SELECT a.name as association_name, va.relationship_type, a.member_term
    FROM vendor_associations va
    JOIN associations a ON a.id = va.association_id
    WHERE va.vendor_id = ?
    ORDER BY a.name
  `)
  .bind(id)
  .all<VendorAssoc>()).results;

interface MyAssoc {
  member_term: string;
}

const myAssociation = Astro.locals.associationId
  ? await db.prepare('SELECT member_term FROM associations WHERE id = ?')
      .bind(Astro.locals.associationId).first<MyAssoc>()
  : null;

const myRels = Astro.locals.associationId
  ? new Set(
      (await db.prepare('SELECT relationship_type FROM vendor_associations WHERE vendor_id = ? AND association_id = ?')
        .bind(id, Astro.locals.associationId).all<{ relationship_type: string }>())
        .results.map((r) => r.relationship_type)
    )
  : new Set<string>();

interface SimilarVendor {
  id: string;
  name: string;
  logo_url: string | null;
  description: string | null;
  shared_count: number;
  category_names: string | null;
  thumbs_up: number;
  thumbs_down: number;
}

interface SpeakerRow {
  id: string;
  name: string;
  title: string | null;
  photo_url: string | null;
  topics: string | null;
  thumbs_up: number;
  thumbs_down: number;
}

const speakers = (await db
  .prepare(`
    SELECT s.id, s.name, s.title, s.photo_url, s.topics,
      COALESCE(SUM(CASE WHEN sr.rating = 'up' THEN 1 ELSE 0 END), 0) as thumbs_up,
      COALESCE(SUM(CASE WHEN sr.rating = 'down' THEN 1 ELSE 0 END), 0) as thumbs_down
    FROM speakers s
    LEFT JOIN speaker_ratings sr ON sr.speaker_id = s.id
    WHERE s.vendor_id = ? AND s.active = 1
    GROUP BY s.id
    ORDER BY s.name
  `)
  .bind(id)
  .all<SpeakerRow>()).results;

const categoryIds = vendorCategories.map((c) => c.id);
let similarVendors: SimilarVendor[] = [];

if (categoryIds.length > 0) {
  const placeholders = categoryIds.map(() => '?').join(',');
  similarVendors = (await db
    .prepare(`
      SELECT v.id, v.name, v.logo_url, v.description,
        COUNT(vc.category_id) as shared_count,
        GROUP_CONCAT(DISTINCT c2.name) as category_names,
        COALESCE(SUM(CASE WHEN r.rating = 'up' THEN 1 ELSE 0 END), 0) as thumbs_up,
        COALESCE(SUM(CASE WHEN r.rating = 'down' THEN 1 ELSE 0 END), 0) as thumbs_down
      FROM vendor_categories vc
      JOIN vendors v ON v.id = vc.vendor_id
      LEFT JOIN vendor_categories vc2 ON vc2.vendor_id = v.id
      LEFT JOIN categories c2 ON c2.id = vc2.category_id
      LEFT JOIN ratings r ON r.vendor_id = v.id
      WHERE vc.category_id IN (${placeholders}) AND v.id != ?
      GROUP BY v.id
      ORDER BY shared_count DESC, v.name ASC
      LIMIT 6
    `)
    .bind(...categoryIds, id)
    .all<SimilarVendor>()).results;
}
---

<Base title={`${vendor.name} | TrustConstellation`}>
  <div class="vendor-detail">
    <a href="/vendors" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      Back to Vendors
    </a>

    <div class="vendor-header">
      <div class="vendor-header-left">
        {vendor.logo_url ? (
          <img src={vendor.logo_url} alt="" class="vendor-logo" />
        ) : (
          <div class="vendor-logo-placeholder">{vendor.name.charAt(0)}</div>
        )}
        <div>
          <h1>{vendor.name}</h1>
          {vendorCategories.length > 0 && (
            <div class="vendor-cats">
              {vendorCategories.map((c) => (
                <span class="badge badge-neutral">{c.name}</span>
              ))}
            </div>
          )}
        </div>
      </div>
      <div class="vendor-header-actions">
        <div class="vendor-rating">
          <div class="rating-score-wrap">
            {score !== null ? (
              <span class="rating-score">{score}</span>
            ) : (
              <span class="rating-score rating-none">&mdash;</span>
            )}
            <span class="rating-label">{score !== null ? `${totalVotes} vote${totalVotes === 1 ? '' : 's'}` : 'No votes'}</span>
          </div>
          <div class="rating-faces">
            <form method="POST" action={`/api/vendors/${id}/rate`}>
              <input type="hidden" name="rating" value="up" />
              <button type="submit" class={`rating-face rating-up ${userRating?.rating === 'up' ? 'active-up' : ''}`} title="Positive">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" stroke="currentColor"/><path d="M8 14s1.5 2 4 2 4-2 4-2" stroke="currentColor"/><line x1="9" y1="9" x2="9.01" y2="9" stroke="currentColor"/><line x1="15" y1="9" x2="15.01" y2="9" stroke="currentColor"/></svg>
              </button>
            </form>
            <form method="POST" action={`/api/vendors/${id}/rate`}>
              <input type="hidden" name="rating" value="down" />
              <button type="submit" class={`rating-face rating-down ${userRating?.rating === 'down' ? 'active-down' : ''}`} title="Negative">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" stroke="currentColor"/><path d="M16 16s-1.5-2-4-2-4 2-4 2" stroke="currentColor"/><line x1="9" y1="9" x2="9.01" y2="9" stroke="currentColor"/><line x1="15" y1="9" x2="15.01" y2="9" stroke="currentColor"/></svg>
              </button>
            </form>
          </div>
        </div>
        {userIsAdmin ? (
          <a href={`/vendors/${id}/edit`} class="btn btn-secondary">Edit</a>
        ) : (
          <a href={`/vendors/${id}/suggest-edit`} class="btn btn-secondary">Suggest Edit</a>
        )}
      </div>
    </div>

    <div class="vendor-columns">
      <div class="vendor-main">
        {vendor.description && <p class="vendor-description">{vendor.description}</p>}

        <!-- Speakers -->
        {(speakers.length > 0 || userIsAdmin) && (
          <div class="section-card">
            <div class="section-header">
              <h2>Speakers ({speakers.length})</h2>
              {userIsAdmin && (
                <a href={`/vendors/${id}/speakers/new`} class="btn btn-secondary btn-sm">Add Speaker</a>
              )}
            </div>
            {speakers.length > 0 ? (
              <div class="speakers-grid">
                {speakers.map((sp) => {
                  const spTotal = sp.thumbs_up + sp.thumbs_down;
                  const spScore = spTotal > 0 ? Math.round((sp.thumbs_up / spTotal) * 100) : null;
                  const spTopics = sp.topics ? sp.topics.split(',').map((t) => t.trim()).filter(Boolean).slice(0, 3) : [];
                  return (
                    <a href={`/vendors/${id}/speakers/${sp.id}`} class="speaker-card">
                      <div class="speaker-card-top">
                        {sp.photo_url ? (
                          <img src={sp.photo_url} alt="" class="speaker-card-photo" />
                        ) : (
                          <div class="speaker-card-photo-placeholder">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                          </div>
                        )}
                        <div class="speaker-card-info">
                          <div class="speaker-card-name">{sp.name}</div>
                          {sp.title && <div class="speaker-card-title">{sp.title}</div>}
                        </div>
                        <div class="speaker-card-score">
                          {spScore !== null ? (
                            <span class={`rating-score-sm ${spScore >= 50 ? 'positive' : 'negative'}`}>
                              {spScore >= 50 ? (
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                              ) : (
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                              )}
                              {spScore}
                            </span>
                          ) : (
                            <span class="rating-none-sm">No ratings</span>
                          )}
                        </div>
                      </div>
                      {spTopics.length > 0 && (
                        <div class="speaker-card-topics">
                          {spTopics.map((t) => (
                            <span class="speaker-topic-tag">{t}</span>
                          ))}
                        </div>
                      )}
                    </a>
                  );
                })}
              </div>
            ) : (
              <p class="empty-sm">No speakers listed yet.</p>
            )}
          </div>
        )}

        <!-- Notes -->
        <div class="section-card">
          <h2>Notes ({notes.length})</h2>
          <form method="POST" action={`/api/vendors/${id}/notes`} class="note-form">
            <textarea name="content" rows="2" placeholder="Add a note visible to all users..." required></textarea>
            <button type="submit" class="btn btn-primary btn-sm">Post Note</button>
          </form>
          {notes.length > 0 && (
            <div class="notes-list">
              {notes.map((n) => (
                <div class="note">
                  <div class="note-header">
                    <span class="note-author">{n.user_name}</span>
                    {n.association_name && <span class="note-org">{n.association_name}</span>}
                    <span class="note-date">{new Date(n.created_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                    {n.user_id === Astro.locals.userId && (
                      <form method="POST" action={`/api/vendors/${id}/notes/${n.id}/delete`} class="note-delete-form" data-confirm="This note will be permanently deleted and cannot be recovered." data-confirm-title="Delete this note?" data-confirm-action="Delete Note">
                        <button type="submit" class="note-delete-btn" title="Delete note">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6"/><path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                        </button>
                      </form>
                    )}
                  </div>
                  <p class="note-content">{n.content}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="vendor-sidebar">
        <!-- Your Association -->
        {Astro.locals.associationId && myAssociation && (
          <div class="section-card">
            <h2>Your Association</h2>
            <p class="your-assoc-name">{Astro.locals.associationName}</p>
            <div class="rel-toggles">
              <form method="POST" action={`/api/vendors/${id}/relationships`}>
                <input type="hidden" name="relationship_type" value="member" />
                <button type="submit" class={`rel-toggle ${myRels.has('member') ? 'active' : ''}`}>
                  <span class="rel-toggle-check">{myRels.has('member') ? '✓' : ''}</span>
                  {myAssociation.member_term}
                </button>
              </form>
              <form method="POST" action={`/api/vendors/${id}/relationships`}>
                <input type="hidden" name="relationship_type" value="endorsed" />
                <button type="submit" class={`rel-toggle endorsed ${myRels.has('endorsed') ? 'active' : ''}`}>
                  <span class="rel-toggle-check">{myRels.has('endorsed') ? '✓' : ''}</span>
                  Endorsed
                </button>
              </form>
            </div>
          </div>
        )}

        <!-- All Association Relationships -->
        <div class="section-card">
          <h2>Associations ({vendorAssociations.length})</h2>
          {vendorAssociations.length === 0 ? (
            <p class="empty-sm">No associations linked yet.</p>
          ) : (
            <div class="assoc-rel-list">
              {vendorAssociations.map((va, i) => (
                <div class={`assoc-rel-row${i >= 3 ? ' assoc-hidden' : ''}`}>
                  <span class="assoc-rel-name">{va.association_name}</span>
                  <div class="assoc-rel-tags">
                    {va.relationship_type === 'endorsed' && <span class="rel-tag rel-tag-endorsed">Endorsed</span>}
                    {va.relationship_type === 'member' && <span class="rel-tag rel-tag-member">{va.member_term}</span>}
                  </div>
                </div>
              ))}
              {vendorAssociations.length > 3 && (
                <button class="assoc-toggle" onclick="
                  const list = this.parentElement;
                  const hidden = list.querySelectorAll('.assoc-hidden');
                  const showing = list.classList.toggle('assoc-expanded');
                  hidden.forEach(el => el.style.display = showing ? '' : 'none');
                  this.textContent = showing
                    ? 'Show less'
                    : `+${hidden.length} more`;
                ">+{vendorAssociations.length - 3} more</button>
              )}
            </div>
          )}
        </div>

        <!-- Contact -->
        {(vendor.website || vendor.contact_name || vendor.contact_email || vendor.contact_phone || vendor.address) && (
          <div class="section-card">
            <h2>Contact</h2>
            {vendor.website && (
              <div class="contact-line">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                <a href={vendor.website.startsWith('http') ? vendor.website : `https://${vendor.website}`} target="_blank" rel="noopener">{new URL(vendor.website.startsWith('http') ? vendor.website : `https://${vendor.website}`).hostname}</a>
              </div>
            )}
            {vendor.contact_name && (
              <div class="contact-line">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span>{vendor.contact_name}</span>
              </div>
            )}
            {vendor.contact_email && (
              <div class="contact-line">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <a href={`mailto:${vendor.contact_email}`}>{vendor.contact_email}</a>
              </div>
            )}
            {vendor.contact_phone && (
              <div class="contact-line">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                <span>{vendor.contact_phone}</span>
              </div>
            )}
            {vendor.address && (
              <div class="contact-line">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{vendor.address}</span>
              </div>
            )}
          </div>
        )}

        <!-- Meta -->
        <div class="section-card meta-card">
          {vendor.creator_name && <div class="meta-line">Added by {vendor.creator_name}</div>}
          <div class="meta-line">{new Date(vendor.created_at + 'Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
        </div>
      </div>
    </div>

    {similarVendors.length > 0 && (
      <div class="similar-section">
        <h2>Similar Vendors</h2>
        <div class="similar-grid">
          {similarVendors.map((sv) => (
            <a href={`/vendors/${sv.id}`} class="similar-card">
              <div class="similar-card-header">
                {sv.logo_url ? (
                  <img src={sv.logo_url} alt="" class="similar-logo" />
                ) : (
                  <div class="similar-logo-placeholder">{sv.name.charAt(0)}</div>
                )}
                <div class="similar-card-info">
                  <div class="similar-card-name">{sv.name}</div>
                </div>
              </div>
              {sv.description && (
                <p class="similar-card-desc">{sv.description.length > 100 ? sv.description.slice(0, 100) + '...' : sv.description}</p>
              )}
              <div class="similar-card-footer">
                {(() => {
                  const total = sv.thumbs_up + sv.thumbs_down;
                  if (total === 0) return <span class="rating-none-sm">No ratings</span>;
                  const s = Math.round((sv.thumbs_up / total) * 100);
                  return (
                    <span class={`rating-score-sm ${s >= 50 ? 'positive' : 'negative'}`}>
                      {s >= 50 ? (
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                      ) : (
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                      )}
                      {s}
                    </span>
                  );
                })()}
                <span class="similar-shared">{sv.shared_count} shared {sv.shared_count === 1 ? 'category' : 'categories'}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <style>
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.82rem;
      color: var(--text-secondary);
      text-decoration: none;
      margin-bottom: 1rem;
    }
    .back-link:hover { color: var(--accent); }
    .vendor-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }
    .vendor-header-left {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    .vendor-logo {
      width: 56px;
      height: 56px;
      border-radius: var(--radius-md);
      object-fit: contain;
      background: var(--surface-raised);
      flex-shrink: 0;
    }
    .vendor-logo-placeholder {
      width: 56px;
      height: 56px;
      border-radius: var(--radius-md);
      background: var(--accent-muted);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.4rem;
      flex-shrink: 0;
    }
    .vendor-header h1 {
      font-size: 1.4rem;
      margin-bottom: 0.15rem;
    }
    .vendor-cats {
      display: flex;
      gap: 0.25rem;
      flex-wrap: wrap;
    }
    .vendor-detail {
      max-width: 1100px;
    }
    .vendor-header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-shrink: 0;
    }
    .vendor-rating {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .rating-score-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
