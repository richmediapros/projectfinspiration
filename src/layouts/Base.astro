---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import BrandLogoStack from '../components/BrandLogoStack.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import { isAdmin } from '../lib/auth';

interface Props {
  title?: string;
}

const { title = 'TrustConstellation' } = Astro.props;
const showAdmin = isAdmin(Astro.locals);
const userName = Astro.locals.userName || '';
const associationName = Astro.locals.associationName || '';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/dashboard') return currentPath === '/dashboard';
  return currentPath === normalized || currentPath.startsWith(normalized + '/');
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme =
            saved ||
            (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <div class="sidebar-brand">
          <a href="/dashboard">
            <BrandLogoStack width={160} showTagline={false} />
          </a>
        </div>

        <nav class="sidebar-nav">
          <div class="nav-section">
            <a href="/dashboard" class:list={['nav-item', { active: isActive('/dashboard') }]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              Dashboard
            </a>
            <a href="/vendors" class:list={['nav-item', { active: isActive('/vendors') }]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              Vendors
            </a>
            <a href="/directory" class:list={['nav-item', { active: isActive('/directory') }]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
              Directory
            </a>
          </div>

          {showAdmin && (
            <div class="nav-section">
              <div class="nav-label">Admin</div>
              <a href="/admin" class:list={['nav-item', { active: currentPath === '/admin' }]}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                Overview
              </a>
              <a href="/admin/associations" class:list={['nav-item', { active: isActive('/admin/associations') }]}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Associations
              </a>
              <a href="/admin/users" class:list={['nav-item', { active: isActive('/admin/users') }]}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                Users
              </a>
              <a href="/admin/suggestions" class:list={['nav-item', { active: isActive('/admin/suggestions') }]}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                Suggestions
              </a>
              <a href="/admin/access-requests" class:list={['nav-item', { active: isActive('/admin/access-requests') }]}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                Access Requests
              </a>
              <a href="/admin/categories" class:list={['nav-item', { active: isActive('/admin/categories') }]}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                Categories
              </a>
              <a href="/admin/activity" class:list={['nav-item', { active: isActive('/admin/activity') }]}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Activity Log
              </a>
            </div>
          )}
        </nav>

        <div class="sidebar-footer">
          <a href="/account" class:list={['nav-item user-item', { active: isActive('/account') }]}>
            <div class="user-avatar">{userName.charAt(0).toUpperCase()}</div>
            <div class="user-info">
              <div class="user-name">{userName}</div>
              {associationName && <div class="user-org">{associationName}</div>}
            </div>
          </a>
          <div class="sidebar-actions">
            <button
              type="button"
              class="sidebar-btn"
              data-theme-toggle
              aria-label="Toggle theme"
              title="Toggle theme"
            >
              <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
              <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            </button>
            <form method="POST" action="/api/auth/logout" class="logout-inline">
              <button type="submit" class="sidebar-btn" title="Sign out" aria-label="Sign out">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              </button>
            </form>
          </div>
        </div>
      </aside>

      <div class="sidebar-backdrop" data-sidebar-backdrop></div>

      <div class="mobile-header">
        <a href="/dashboard" class="mobile-brand">Trust<span class="brand-light">Constellation</span></a>
        <button type="button" class="mobile-menu-btn" data-mobile-toggle aria-label="Open menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>

      <main class="app-main">
        <div class="app-content">
          <slot />
        </div>
      </main>
    </div>

    <ScrollToTop />
    <ConfirmModal />

    <style>
      /* ── Sidebar ─────────────────────────── */
      .sidebar-brand {
        padding: 1.25rem 0.75rem 1rem;
        text-align: center;
      }
      .sidebar-brand a {
        display: inline-block;
        text-decoration: none;
      }
      .sidebar-brand a:hover { opacity: 0.85; }
      .sidebar-brand :global(.brand-logo) {
        width: 100%;
        height: auto;
      }

      .sidebar-nav {
        flex: 1;
        padding: 0.5rem 0.75rem;
        overflow-y: auto;
      }
      .nav-section {
        margin-bottom: 0.5rem;
      }
      .nav-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        padding: 1rem 0.75rem 0.4rem;
      }
      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-md);
        color: var(--text-secondary);
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.12s ease;
        margin-bottom: 1px;
      }
      .nav-item:hover {
        color: var(--text);
        background: var(--sidebar-hover);
      }
      .nav-item.active {
        color: var(--accent);
        background: var(--sidebar-active);
      }
      .nav-item svg {
        flex-shrink: 0;
        opacity: 0.7;
      }
      .nav-item.active svg {
        opacity: 1;
      }

      /* ── Sidebar footer ─────────────────── */
      .sidebar-footer {
        border-top: 1px solid var(--sidebar-border);
        padding: 0.75rem;
      }
      .user-item {
        margin-bottom: 0.5rem;
      }
      .user-avatar {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        background: var(--accent-muted);
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 700;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border: 1px solid var(--accent-border);
      }
      .user-info {
        min-width: 0;
      }
      .user-name {
        font-size: 0.825rem;
        font-weight: 600;
        color: var(--text);
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .user-org {
        font-size: 0.7rem;
        color: var(--muted);
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sidebar-actions {
        display: flex;
        gap: 0.25rem;
      }
      .sidebar-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        color: var(--muted);
        background: transparent;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition: all 0.12s ease;
      }
      .sidebar-btn:hover {
        color: var(--text);
        border-color: var(--border-hover);
        background: var(--surface-raised);
      }
      .logout-inline {
        display: inline;
        margin: 0;
      }

      /* Theme toggle icons */
      .sidebar-btn .icon-sun { display: none; }
      :global([data-theme='light']) .sidebar-btn .icon-sun { display: block; }
      :global([data-theme='light']) .sidebar-btn .icon-moon { display: none; }

      /* ── Mobile header ──────────────────── */
      .mobile-header {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 56px;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        z-index: 90;
      }
      .mobile-brand {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1rem;
        color: var(--text);
      }
      .mobile-brand:hover { color: var(--text); }
      .mobile-menu-btn {
        background: none;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        padding: 0.4rem;
      }

      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 89;
        opacity: 0;
        transition: opacity 0.2s ease;
      }
      .sidebar-backdrop.visible {
        opacity: 1;
      }

      @media (max-width: 768px) {
        .app-main {
          padding-top: 56px;
        }
        .app-sidebar.open {
          display: flex;
          box-shadow: 4px 0 24px rgba(0, 0, 0, 0.3);
        }
        .app-sidebar.open ~ .sidebar-backdrop {
          display: block;
        }
      }
    </style>

    <script>
      const themeBtn = document.querySelector('[data-theme-toggle]');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const current =
            document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          const next = current === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      }

      const mobileToggle = document.querySelector('[data-mobile-toggle]');
      const sidebar = document.querySelector('.app-sidebar');
      const backdrop = document.querySelector('[data-sidebar-backdrop]') as HTMLElement | null;

      function closeSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.remove('open');
        backdrop.classList.remove('visible');
      }

      if (mobileToggle && sidebar && backdrop) {
        mobileToggle.addEventListener('click', () => {
          const opening = !sidebar.classList.contains('open');
          sidebar.classList.toggle('open');
          if (opening) {
            requestAnimationFrame(() => backdrop.classList.add('visible'));
          } else {
            backdrop.classList.remove('visible');
          }
        });
        backdrop.addEventListener('click', closeSidebar);
        sidebar.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) closeSidebar();
        });
      }
    </script>
  </body>
</html>
