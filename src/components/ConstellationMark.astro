---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---
<svg viewBox="6 3 120 116" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="constellation-mark">
  <g class="mark-lines">
    <line x1="63.84" y1="20.07" x2="62.58" y2="52.74" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".5"/>
    <line x1="22.84" y1="28.07" x2="57.64" y2="14.91" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".5"/>
    <line x1="98.43" y1="97.11" x2="112.74" y2="78.38" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".5"/>
    <line x1="21.88" y1="34.66" x2="56.18" y2="55.99" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".5"/>
    <line x1="57.94" y1="64.89" x2="22.15" y2="103.45" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".5"/>
    <line x1="65.81" y1="65.04" x2="91.14" y2="96.57" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".5"/>
    <line x1="68.4" y1="61.24" x2="109.75" y2="71.91" stroke-linecap="round" stroke-miterlimit="10" stroke-width=".5"/>
  </g>
  <g class="mark-nodes">
    <circle cx="16.41" cy="30.54" r="3.65"/>
    <circle cx="64.26" cy="13.22" r="3.65"/>
    <circle cx="115.98" cy="73.14" r="3.65"/>
    <circle cx="94.79" cy="101.85" r="3.65"/>
    <circle cx="16.41" cy="108.92" r="5.47"/>
  </g>
  <g class="mark-hub">
    <circle cx="61.98" cy="59.47" r="3.65"/>
  </g>
</svg>
<style>
  .constellation-mark { flex-shrink: 0; }
  .mark-lines { stroke: var(--muted); }
  .mark-nodes { fill: var(--muted); }
  .mark-hub { fill: var(--accent); }
  :root[data-theme='light'] .mark-lines { stroke: #7a8496; }
  :root[data-theme='light'] .mark-nodes { fill: #122045; }
  :root[data-theme='light'] .mark-hub { fill: #1e499c; }
</style>
