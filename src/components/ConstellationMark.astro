---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---
<svg viewBox="0 0 32 32" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="constellation-mark">
  <line x1="10" y1="5" x2="19" y2="4" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="19" y1="4" x2="26" y2="8" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="10" y1="5" x2="16" y2="13" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="19" y1="4" x2="16" y2="13" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="26" y1="8" x2="27" y2="14" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="16" y1="13" x2="14" y2="19" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="16" y1="13" x2="25" y2="19" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="27" y1="14" x2="25" y2="19" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="14" y1="19" x2="25" y2="19" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="14" y1="19" x2="8" y2="25" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="14" y1="19" x2="15" y2="28" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <line x1="8" y1="25" x2="15" y2="28" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
  <circle cx="10" cy="5" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="19" cy="4" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="26" cy="8" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="16" cy="13" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="27" cy="14" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="25" cy="19" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="8" cy="25" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="15" cy="28" r="1.8" fill="currentColor" opacity="0.4"/>
  <circle cx="14" cy="19" r="3.2" fill="var(--accent)"/>
</svg>
<style>
  .constellation-mark { flex-shrink: 0; }
</style>
