---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---
<svg viewBox="0 0 32 32" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="constellation-mark">
  <!-- spokes from center hub -->
  <line x1="16" y1="14" x2="8" y2="5" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
  <line x1="16" y1="14" x2="14" y2="3" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
  <line x1="16" y1="14" x2="4" y2="15" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
  <line x1="16" y1="14" x2="8" y2="23" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
  <line x1="16" y1="14" x2="14" y2="26" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
  <line x1="16" y1="14" x2="23" y2="23" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
  <line x1="16" y1="14" x2="27" y2="9" stroke="currentColor" stroke-width="0.8" opacity="0.25"/>
  <!-- outer nodes (gray, varying sizes) -->
  <circle cx="8" cy="5" r="2.2" fill="currentColor" opacity="0.35"/>
  <circle cx="14" cy="3" r="1.2" fill="var(--accent)" opacity="0.7"/>
  <circle cx="4" cy="15" r="2.8" fill="currentColor" opacity="0.35"/>
  <circle cx="8" cy="23" r="1.8" fill="currentColor" opacity="0.45"/>
  <circle cx="14" cy="26" r="1.4" fill="currentColor" opacity="0.3"/>
  <circle cx="23" cy="23" r="2.0" fill="currentColor" opacity="0.35"/>
  <circle cx="27" cy="9" r="1.2" fill="var(--accent)" opacity="0.7"/>
  <!-- center hub -->
  <circle cx="16" cy="14" r="3.2" fill="var(--accent)"/>
</svg>
<style>
  .constellation-mark { flex-shrink: 0; }
</style>
